[radmachine]
base_url = "https://radmachine.radformation.com"
customer_id = "<customer_id - based on your URL>"
username = "<your_username>"
token = "<your_api_token>"
# Alternatively, keep the token in an environment variable:
# token_env = "RADMACHINE_TOKEN"

[logbook]
default_file = "~/org/teap-logbook.org"
timezone = "Australia/Brisbane"

[extensions]
# Add directories containing user extension modules, for example:
# paths = ["~/.config/radlog", "./examples"]
paths = ["./examples"]

[grouping]
# Object in MODULE:ATTRIBUTE form. The object should provide the methods used by
# radlog.group.GroupingRules.
rules = "group_tcc_similar:RULES"

[render]
# Callable in MODULE:ATTRIBUTE form.
logbook_org_renderer = "render_ag_org:render_candidate"
